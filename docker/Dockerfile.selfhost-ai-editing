# syntax=docker/dockerfile:1
#
# The AI editing worker for the self-host stack: a Cloudflare Worker, run on
# workerd by `wrangler dev` (as docker/ai-editing-worker.Dockerfile does for
# `just run_local`, but with the code baked in instead of mounted). The
# backend reads a document's markdown through it, so chat and agents cannot
# read documents without it.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.selfhost-ai-editing -t macro-ai-editing-worker .
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g bun

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CI=true \
    WRANGLER_SEND_METRICS=false

WORKDIR /app
COPY . .

# The whole workspace: some packages rely on dependencies hoisted from others.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

WORKDIR /app/services/ai-editing-worker
RUN bun scripts/generate-sandbox.ts

EXPOSE 8933

# Provider keys reach the worker as secret bindings, which wrangler reads from
# .dev.vars. Trace export is off: there is no collector in the stack.
CMD ["sh", "-c", "printf 'OPENAI_API_KEY=%s\\nANTHROPIC_API_KEY=%s\\nCEREBRAS_API_KEY=%s\\n' \"$OPENAI_API_KEY\" \"$ANTHROPIC_API_KEY\" \"$CEREBRAS_API_KEY\" > .dev.vars && exec npx wrangler dev --env local --local --ip 0.0.0.0 --port 8933 --var OTEL_EXPORTER_OTLP_ENDPOINT:"]
