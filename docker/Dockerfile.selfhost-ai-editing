# syntax=docker/dockerfile:1
#
# The AI editing worker for the self-host stack: a Cloudflare Worker, run on
# workerd by `wrangler dev` (docker/ai-editing-worker.Dockerfile does the same
# for `just run_local`, but mounts the repository and its installed
# dependencies). The backend reads a document's markdown through it, so chat
# and agents cannot read documents without it.
#
# The builder installs the monorepo and bundles the worker; the image ships
# only the bundle and wrangler.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.selfhost-ai-editing -t macro-ai-editing-worker .
FROM node:22-bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g bun

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CI=true \
    WRANGLER_SEND_METRICS=false

WORKDIR /app
COPY . .

# The whole workspace: some packages rely on dependencies hoisted from others.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

WORKDIR /app/services/ai-editing-worker
RUN bun scripts/generate-sandbox.ts \
    && npx wrangler deploy --dry-run --env local --outdir /bundle \
    && rm -f /bundle/*.map /bundle/README.md

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CI=true \
    WRANGLER_SEND_METRICS=false

WORKDIR /app
# The wrangler the repository pins (services/ai-editing-worker/package.json,
# resolved in bun.lock); bump them together.
RUN npm install --no-save --no-audit --no-fund wrangler@4.110.0 && npm cache clean --force
COPY --from=builder /bundle/ ./
COPY services/ai-editing-worker/wrangler.docker.toml ./

EXPOSE 8933

# Provider keys reach the worker as secret bindings, which wrangler reads from
# .dev.vars.
CMD ["sh", "-c", "printf 'OPENAI_API_KEY=%s\\nANTHROPIC_API_KEY=%s\\nCEREBRAS_API_KEY=%s\\n' \"$OPENAI_API_KEY\" \"$ANTHROPIC_API_KEY\" \"$CEREBRAS_API_KEY\" > .dev.vars && exec npx wrangler dev --local --config wrangler.docker.toml --ip 0.0.0.0 --port 8933"]
