# Version-control and local-agent state
.git
.jj
.agents
.cursor
.claude/.local
.pi/outputs
/infra/local/generated

# Legacy layout directories may still contain ignored local build artifacts.
/agents
/js
/rust

# Unlike the default .dockerignore, /apps and /packages stay in the context:
# the services' code_mode_assets build script runs the generator in
# packages/code-mode-sdk, and `bun install` needs every workspace manifest.

# Secrets and local configuration
.env
.env.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.dev.vars*

# Dependency and generated output
**/node_modules
**/target
**/dist
**/build
# Source modules named `build` (crates/ai_engine/src/build) are not output.
!**/src/build
**/.wrangler
**/test-results
**/playwright-report
**/coverage
**/.cache
**/.vite
**/*.tsbuildinfo
**/*.log

# Editor and operating-system noise
**/.DS_Store
**/.idea
**/.vscode
**/*.swp
**/*.swo
