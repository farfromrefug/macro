# Configuration for docker/selfhost/docker-compose.yml.
#
# Run ./setup.sh to create .env from this file: it fills every empty secret
# below with a generated value and leaves everything else as it is. Do not
# commit .env.

# --- Images ---------------------------------------------------------------------
# Where the compose file pulls the macro-* images from, and which tag.
MACRO_REGISTRY=ghcr.io/macro-inc
MACRO_VERSION=latest

# --- Where the browser reaches the stack ---------------------------------------
# The proxy (Caddy) serves the app and every backend route on one origin.
#
# Trial on this machine: Caddy issues a certificate from its own CA, which your
# browser will not trust until you install it (`docker compose cp
# proxy:/data/caddy/pki/authorities/local/root.crt .`).
#
# Public hostname: set SITE_ADDRESS to the name, TLS_MODE to your email (Caddy
# then gets a Let's Encrypt certificate; ports 80 and 443 must reach this
# host), PUBLIC_ORIGIN to https://<name> and PROXY_PORT to 443.
PUBLIC_ORIGIN=https://localhost:8090
SITE_ADDRESS=localhost:8090
PROXY_PORT=8090
TLS_MODE=internal

# --- Mail -------------------------------------------------------------------------
# Sign-in is by emailed code. Until you point this at a real SMTP server, the
# bundled Mailpit catches every message: read them at PUBLIC_ORIGIN/mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
# NONE, SSL or TLS. Mailpit takes NONE.
SMTP_SECURITY=NONE
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@macro.local
MAIL_FROM_DOMAIN=macro.local

# --- Identity admin -----------------------------------------------------------------
# The FusionAuth admin UI listens on http://localhost:FUSIONAUTH_PORT (this
# machine only). These credentials are created on its first boot. Use an address
# nobody signs in to Macro with: this account is registered only for the admin UI,
# so signing in to the app with the same address fails ("unable to perform
# verification").
FUSIONAUTH_PORT=9011
FUSIONAUTH_ADMIN_EMAIL=admin@fusionauth.local
FUSIONAUTH_ADMIN_PASSWORD=

# --- Database -------------------------------------------------------------------------
POSTGRES_USER=macro
POSTGRES_PASSWORD=
FUSIONAUTH_DB_PASSWORD=

# --- Secrets (generated by setup.sh) ---------------------------------------------
# Shared between services; changing one on a running stack breaks sign-in until
# every service and the FusionAuth database agree again, so treat them as fixed
# once the stack has been started.
INTERNAL_API_SECRET_KEY=
DOCUMENT_PERMISSION_SECRET=
INTERNAL_CALL_SECRET=
URL_SIGNING_HMAC=
APP_SECRET=
WEBHOOK_SECRET=
JWT_SECRET_KEY=
FUSIONAUTH_API_KEY=
FUSIONAUTH_CLIENT_SECRET=
# Base64 of a 32-byte AES key.
MCP_CREDENTIALS_KEY=
# PEM keys, written on one line with \n escapes.
MACRO_API_TOKEN_PRIVATE_KEY=
MACRO_API_TOKEN_PUBLIC_KEY=
ATTACHMENT_LINK_SIGNING_KEY=
# OpenSSH ed25519 private key, same format.
PREVIEW_SSH_HOST_KEY=

# --- Storage ------------------------------------------------------------------------------
# LocalStack stands in for S3, SQS, DynamoDB and KMS. 1 keeps its state (and so
# your uploaded files) in the localstack_data volume across restarts.
LOCALSTACK_PERSISTENCE=1
# A small JVM: one node, a few thousand documents. Raise -Xmx for a big mailbox.
OPENSEARCH_JAVA_OPTS=-Xms256m -Xmx256m -XX:-UseG1GC -XX:+UseSerialGC -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=64m -Xss512k

# --- Video calls (optional) ---------------------------------------------------------
# ./setup.sh --calls turns this on: it generates the key pair, sets
# COMPOSE_PROFILES=calls (which starts the `livekit` service) and points
# LIVEKIT_SERVER_URL at it. Calls need ports 7880/tcp, 7881/tcp and 7882/udp.
# For other machines to join, set LIVEKIT_BIND=0.0.0.0, LIVEKIT_NODE_IP to this
# host's public IP, and LIVEKIT_HOST/LIVEKIT_SERVER_URL to a name they can
# resolve (wss:// needs a TLS terminator in front of port 7880).
# COMPOSE_PROFILES=calls
# LIVEKIT_SERVER_URL=ws://livekit.localhost:7880
# LIVEKIT_HOST=livekit.localhost
# LIVEKIT_NODE_IP=127.0.0.1
# LIVEKIT_BIND=127.0.0.1
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Optional integrations ----------------------------------------------------------------
# Left unset, each of these is a placeholder that satisfies the services' startup
# checks; the feature behind it does not work until you give it a real value.
# Set the Google pair before the first `docker compose up`: FusionAuth stores it
# when it first boots.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
